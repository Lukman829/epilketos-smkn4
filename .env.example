# E-PILKETOS SMKN 4 KOTA SERANG - Environment Configuration Example
# Copy this file to .env.local for local development.

# 1. Supabase Configuration (Optional for instant local demo mode)
# If left empty, the application uses its built-in in-memory / storage engine.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Admin Security Credentials
# Two authorized administrator accounts as specified in the product specification:
# 1) Ketua Panitia
# 2) Admin Utama
ADMIN_KETUA_USERNAME=ketua.panitia
ADMIN_KETUA_PASSWORD=SerangUnggul2026!

ADMIN_UTAMA_USERNAME=admin.utama
ADMIN_UTAMA_PASSWORD=PilketoSMKN4_Secure!

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
