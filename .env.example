# E-PILKETOS SMKN 4 KOTA SERANG - Environment Configuration Template (.env.example)
# ==============================================================================
# PERINGATAN KEAMANAN:
# File ini HANYA TEMPLATE untuk publik di GitHub.
# JANGAN PERNAH memasukkan kredensial asli, password produksi, atau secret key nyata di sini.
# 
# PANDUAN PENGGUNAAN:
# 1. Untuk Pengembangan Lokal:
#    Salin file ini menjadi .env.local (`cp .env.example .env.local`)
#    File .env.local sudah masuk .gitignore dan tidak akan diunggah ke GitHub.
#
# 2. Untuk Produksi di Vercel:
#    Isi variabel-variabel di bawah ini langsung di:
#    Vercel Dashboard -> Project Settings -> Environment Variables.
#    Pastikan nilai di Vercel berbeda, acak, dan bersifat rahasia.
# ==============================================================================

# 1. Supabase Configuration (Database & RPCs)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dummy-anon-key-replace-with-real-one-in-vercel
SUPABASE_SERVICE_ROLE_KEY=your-dummy-service-role-key-replace-with-real-one-in-vercel

# 2. Admin Authentication Credentials
# Akun 1: Ketua Panitia Pelaksana (Akses terbatas)
ADMIN_KETUA_USERNAME=panitia_contoh
ADMIN_KETUA_PASSWORD=GantiDenganPasswordKuatKetuaPanitiaDiVercel!

# Akun 2: Administrator Utama (Akses penuh)
ADMIN_UTAMA_USERNAME=admin_contoh
ADMIN_UTAMA_PASSWORD=GantiDenganPasswordKuatAdminUtamaDiVercel!

# 3. Kunci Rahasia Sesi HMAC (Wajib diganti dengan string acak minimal 32 karakter di Vercel)
# PERINGATAN: Jangan gunakan string contoh ini di produksi!
SESSION_SECRET=ganti-dengan-string-rahasia-acak-minimal-32-karakter-khusus-vercel

# 4. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
